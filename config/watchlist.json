  "watchlists": [
    {
      "name": "High Conviction",
      "rule": {"type": "decision_in", "decisions": ["TRADE", "INCREASE_POSITION"]}
    },
    {
      "name": "Watch",
      "rule": {"type": "decision_in", "decisions": ["WATCH", "WAIT"]}

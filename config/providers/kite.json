{
  "_meta": {
    "description": "Zerodha Kite Connect read-only MarketDataProvider (R4 / DD-1). Secrets stay in .env (KITE_API_KEY, KITE_ACCESS_TOKEN). Default ingestion.provider remains 'file' until you flip config.",
    "layer": "provider"
  },
  "exchange": "NSE",
  "instrument_types": ["EQ"],
  "symbols": ["INFY"],
  "index_instruments": [
    "NSE:NIFTY 50",
    "NSE:NIFTY BANK",
    "NSE:NIFTY IT",
    "NSE:NIFTY AUTO",
    "NSE:NIFTY PHARMA",
    "NSE:NIFTY FMCG",
    "NSE:NIFTY METAL",
    "NSE:NIFTY REALTY",
    "NSE:NIFTY ENERGY",
    "NSE:NIFTY PSU BANK"
  ],
  "india_vix_instrument": "NSE:INDIA VIX",
  "base_url": "https://api.kite.trade",
  "quote_batch_size": 500,
  "rate_limit": {
    "historical_min_interval_seconds": 0.334,
    "quote_min_interval_seconds": 1.0,
    "other_min_interval_seconds": 0.1,
    "max_429_retries": 3,
    "retry_backoff_base_seconds": 1.0
  },
  "capabilities": {
    "timeframes": ["1d", "5m", "15m"],
    "max_history_days": 2000,
    "supports_quotes": true,
    "supports_market_snapshot": true
